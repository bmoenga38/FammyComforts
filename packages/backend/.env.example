# Convex deployment wiring (project: bry-code/sommycomfort).
# `npx convex dev` writes CONVEX_DEPLOYMENT here and prints the deployment URL.
#   Development deployment: quixotic-boar-465
#   Production deployment:  notable-cod-441
CONVEX_DEPLOYMENT=

# The web app consumes the deployment URL (see apps/web Convex provider wiring):
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# ---------------------------------------------------------------------------
# HostPinnacle SMS gateway (notificationsEngine.drain → lib/hostpinnacle.ts).
#
# These are NOT read from this file. Convex actions only see environment
# variables set on the deployment itself, so set them per deployment:
#
#   npx convex env set HOSTPINNACLE_USER_ID  '<portal username>'
#   npx convex env set HOSTPINNACLE_PASSWORD '<portal password>'
#
# Listed here for discoverability only — never commit the password.
#
# HOSTPINNACLE_USER_ID         required. Portal username (lowercase). Half of the
#                              portal login, so it is not committed here either.
# HOSTPINNACLE_PASSWORD        required. Portal password. Secret — dashboard/CLI only.
# HOSTPINNACLE_SENDER_ID       optional. Defaults to AMMY_HOPES.
# HOSTPINNACLE_API_URL         optional. Defaults to
#                              https://smsportal.hostpinnacle.co.ke/SMSApi/send
# HOSTPINNACLE_DUPLICATE_CHECK optional. Defaults to off. Leave it off: the
#                              provider's duplicate window would silently drop
#                              the queue's legitimate retries.
#
# With USER_ID/PASSWORD unset, SMS rows stay `queued` rather than being faked
# as sent — the engine's deliberate behaviour for unconfigured channels.
